# ローカルで動作確認するときは、このファイルを .env にコピーして値を入れてください。
# GitHub Actions で動かす場合は、リポジトリの Settings > Secrets and variables > Actions
# に同じ名前で登録します（.env は不要）。

# 楽天ウェブサービスの申請が承認されると発行されます
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# 楽天アフィリエイトの管理画面で確認できるID
RAKUTEN_AFFILIATE_ID=

# Typefully の Settings > API で発行
TYPEFULLY_API_KEY=
# `node src/list-sets.mjs` で確認できます
TYPEFULLY_SOCIAL_SET_ID=
